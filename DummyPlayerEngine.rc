// Версионный ресурс DummyPlayerEngine.
// Нужен, чтобы файл имел нормальные метаданные (описание, версия, автор, ссылка).
// Это обычная информация о программе, какую добавляет любой компилятор.

1 VERSIONINFO
FILEVERSION    1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEOS         0x40004L   // VOS_NT_WINDOWS32
FILETYPE       0x2L       // VFT_DLL
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"   // en-US, Unicode
        {
            VALUE "CompanyName",      "grafingl"
            VALUE "FileDescription",  "DummyPlayerEngine - NPC-style engine sound for GTA III, Vice City and San Andreas"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "DummyPlayerEngine"
            VALUE "LegalCopyright",   "Copyright (c) 2026 grafingl. MIT License"
            VALUE "OriginalFilename", "DummyPlayerEngine.asi"
            VALUE "ProductName",      "DummyPlayerEngine"
            VALUE "ProductVersion",   "1.3.0.0"
            VALUE "Comments",         "Open-source GTA audio mod. Source: https://github.com/grafingl/DummyPlayerEngine"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 0x4b0
    }
}
